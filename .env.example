# Unsplash API — get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# GitHub Personal Access Token with 'repo' scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Full HTTPS URL of your GitHub repo (used for gh-pages push auth)
GITHUB_REPO_URL=https://github.com/richardawe/localtest.git

# Nigeria content desk (main_ngr.py) — pushes drafts to ngr.ltd's admin
# review queue. NGR_API_BASE defaults to https://ngr.ltd; override for
# local testing against `composer run dev`. CONTENT_PIPELINE_TOKEN must
# match the value set in ngr.ltd's own .env (generate with
# `php artisan tinker` -> `Str::random(64)` on that side).
NGR_API_BASE=https://ngr.ltd
CONTENT_PIPELINE_TOKEN=
